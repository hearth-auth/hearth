meta {
  name: Introspect Token
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/introspect
  body: json
  auth: none
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

body:json {
  {
    "token": "{{accessToken}}",
    "token_type_hint": "access_token",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
  }
}

docs {
  Introspection is confidential-clients-only: `clientId`/`clientSecret` must be a
  confidential client (e.g. run "Dynamic Client Registration", which stores the
  server-generated secret). A public client's `client_id` alone gets
  `401 invalid_client`.
}
