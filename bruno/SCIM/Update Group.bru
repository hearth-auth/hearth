meta {
  name: Update Group
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/scim/v2/Groups/{{groupId}}
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/scim+json
  Accept: application/scim+json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
    "Operations": [
      {
        "op": "replace",
        "path": "displayName",
        "value": "Engineering Updated"
      },
      {
        "op": "add",
        "path": "members",
        "value": [
          {
            "value": "{{userId}}",
            "display": "Alice Smith"
          }
        ]
      }
    ]
  }
}
