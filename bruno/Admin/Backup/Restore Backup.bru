meta {
  name: Restore Backup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/backup/restore
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "data": "<base64-encoded-backup-data>"
  }
}
