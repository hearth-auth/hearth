meta {
  name: Update Webhook
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/admin/webhooks/{{webhookId}}
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "url": "https://example.com/webhooks/hearth-updated",
    "events": ["user.created", "user.updated", "user.deleted", "session.created"],
    "secret": "whsec_newsecret"
  }
}
