meta {
  name: Create Webhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/webhooks
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "url": "https://example.com/webhooks/hearth",
    "events": ["user.created", "user.updated", "session.created"],
    "secret": "whsec_supersecret"
  }
}
