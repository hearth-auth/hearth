meta {
  name: Update Role
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/admin/roles/{{roleId}}
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "editor-updated",
    "permissions": ["users:read", "users:write", "groups:read"]
  }
}
