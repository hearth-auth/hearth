meta {
  name: Create Role
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/roles
  body: json
  auth: bearer
}

headers {
  X-Realm-ID: {{realmId}}
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "editor",
    "permissions": ["users:read", "users:write"]
  }
}
