# Hearth server URL (no trailing slash)
HEARTH_BASE_URL=http://127.0.0.1:8420

# Realm UUID — from "hearth migrate" output or the admin UI
HEARTH_REALM_ID=

# OAuth client registered in Hearth
HEARTH_CLIENT_ID=

# Must match exactly what you registered in Hearth
HEARTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Secret for signing the session cookie — generate with: openssl rand -base64 32
SESSION_SECRET=
