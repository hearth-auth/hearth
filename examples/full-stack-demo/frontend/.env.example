# Copy to .env and fill in values from demo.sh output.
#
# VITE_HEARTH_URL   — Hearth server base URL (no trailing slash)
# VITE_REALM_SLUG   — Realm name used in OIDC URL paths (from hearth.yaml `realms:` key)
# VITE_REALM_ID     — Realm UUID printed by demo.sh ("demo realm id: <uuid>")
# VITE_CLIENT_ID    — OAuth application name (from hearth.yaml `applications:` key)
# VITE_API_URL      — Go backend base URL (Phase 3); used for /api/notes and /admin/users

VITE_HEARTH_URL=http://localhost:8420
VITE_REALM_SLUG=demo
VITE_REALM_ID=<paste UUID from demo.sh output>
VITE_CLIENT_ID=hearth-hub
VITE_API_URL=http://localhost:8421
