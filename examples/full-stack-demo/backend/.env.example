# Hearth full-stack demo — backend environment variables
# Copy to .env and fill in values before running.

# Base URL of the running Hearth server (no trailing slash)
HEARTH_URL=http://localhost:8420

# Realm name as configured in hearth.yaml
REALM_ID=demo

# Port the API server binds on (default: 8421)
PORT=8421

# Revocation introspection cache TTL (Go duration, e.g. "3s", "30s").
# The backend validates each request's access token against Hearth's RFC 7662
# introspection endpoint and caches the verdict for this long, so a revoked
# token is refused within ~TTL rather than staying valid until it expires.
# Shorter = faster revocation, more calls to Hearth; longer = cheaper, staler.
# "0" introspects on every request (strongest consistency, highest cost).
# Default when unset: 3s.
INTROSPECT_CACHE_TTL=3s
