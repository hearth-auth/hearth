{
  "name": "@hearth-auth/sdk",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hearth-auth/hearth.git",
    "directory": "sdks/typescript"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "import": "./dist/nextjs/index.js",
      "default": "./dist/nextjs/index.js"
    },
    "./nextjs/edge": {
      "types": "./dist/nextjs/edge.d.ts",
      "import": "./dist/nextjs/edge.js",
      "default": "./dist/nextjs/edge.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jose": "^5.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=17.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "react": "^18.3.0",
    "react-dom": "^19.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "ws": ">=8.21.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
