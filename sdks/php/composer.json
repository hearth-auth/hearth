{
  "name": "hearth-auth/hearth-php",
  "description": "Official PHP SDK for Hearth Identity Provider",
  "type": "library",
  "license": "MIT",
  "keywords": ["oauth2", "oidc", "jwt", "auth", "hearth", "identity"],
  "homepage": "https://github.com/hearth-auth/hearth",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-sodium": "*",
    "lcobucci/jwt": "^5.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "guzzlehttp/guzzle": "^7.5",
    "guzzlehttp/psr7": "^2.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 — required for Laravel integration (HearthServiceProvider, Facades, middleware adapter)",
    "symfony/http-foundation": "^6.0 || ^7.0 — required by the Laravel middleware adapter (transitively provided by illuminate/http)"
  },
  "autoload": {
    "psr-4": {
      "Hearth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hearth\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testsuite unit",
    "test-integration": "vendor/bin/phpunit --testsuite integration",
    "test-all": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Hearth\\Laravel\\HearthServiceProvider"
      ],
      "aliases": {
        "Hearth": "Hearth\\Laravel\\Facades\\Hearth"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
