#!/usr/bin/env bash
# Pre-commit hook: auto-regenerate derived artifacts.
#
# Enabled by `make setup`, which sets:
#   git config core.hooksPath .githooks
#
# Three regenerations happen here:
#   1. Proto format + lint + SDK type regen from staged proto/*.proto changes (TS + Go).
#   2. Tailwind app.css from staged template/CSS/config changes.
#
# Both produce checked-in artifacts that CI verifies via `make ci-fast`
# (proto-lint + proto-format-check + css-check). Regenerating here keeps the commit atomic.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Proto: format, lint, and regenerate SDK types when proto files staged ─
staged_proto=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^proto/.*\.proto$' || true)

if [ -n "$staged_proto" ]; then
  if ! command -v buf >/dev/null 2>&1; then
    cat >&2 <<'EOF'
error: pre-commit hook needs 'buf' on PATH to regenerate SDK types.

Install buf:  https://buf.build/docs/installation
Then retry the commit.

To bypass (discouraged — CI will fail via 'make proto-check'):
  git commit --no-verify
EOF
    exit 1
  fi

  echo "proto changes staged; formatting and linting .proto files..."
  (cd proto && buf format -w)
  (cd proto && buf lint)

  echo "proto lint passed; regenerating SDK types via 'buf generate'..."
  (cd proto && buf generate)

  # Re-stage formatted + regenerated output. No-op when output is unchanged.
  git add proto sdks/typescript/src/generated sdks/go/generated
fi

# ── Rust: auto-format staged .rs files with cargo fmt ───────────────────
#
# Why: keep formatting drift out of review. `cargo fmt` rewrites in place
# (no --check), then we re-stage the originally staged files.
#
# Footgun guard: if a staged .rs file also has unstaged hunks, formatting
# + `git add` would silently swallow those unstaged hunks into the commit.
# We skip those files and warn — the user can re-stage explicitly.
staged_rs=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.rs$' || true)

if [ -n "$staged_rs" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    cat >&2 <<'EOF'
error: pre-commit hook needs 'cargo' on PATH to format staged Rust files.

Install Rust:  https://rustup.rs
Then retry the commit.

To bypass (discouraged — CI will fail via 'make fmt'):
  git commit --no-verify
EOF
    exit 1
  fi

  # Partition staged .rs into "clean" (fully staged) vs "partial" (also has
  # unstaged hunks). Only re-stage clean files after formatting.
  clean_rs=""
  partial_rs=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ -n "$(git diff --name-only -- "$f")" ]; then
      partial_rs="${partial_rs}${f}"$'\n'
    else
      clean_rs="${clean_rs}${f}"$'\n'
    fi
  done <<< "$staged_rs"

  if [ -n "$partial_rs" ]; then
    cat >&2 <<EOF
warning: these staged .rs files also have unstaged changes; skipping fmt
  to avoid pulling unstaged hunks into the commit:
$(printf '  - %s\n' $partial_rs)
  Stage the rest with 'git add' or stash unstaged changes, then retry.
EOF
  fi

  echo "rust changes staged; running 'cargo fmt'..."
  cargo fmt --all

  # Re-stage only the originally-staged, fully-clean .rs files. No-op when
  # formatting produced no changes.
  if [ -n "$clean_rs" ]; then
    # shellcheck disable=SC2086
    git add -- $clean_rs
  fi
fi

# ── Changelog: warn when src/proto/sdks change but CHANGELOG.md does not ─
#
# Why: CLAUDE.md requires a CHANGELOG.md entry for every user-visible change.
# Warn-only (no exit 1) so hotfixes are never blocked; CI does not enforce.
staged_code=$(git diff --cached --name-only --diff-filter=ACMRD \
  | grep -E '^(src/|proto/|sdks/)' || true)
staged_changelog=$(git diff --cached --name-only --diff-filter=ACMRD \
  | grep -F 'CHANGELOG.md' || true)

if [ -n "$staged_code" ] && [ -z "$staged_changelog" ]; then
  cat >&2 <<'EOF'
warning: src/, proto/, or sdks/ files are staged but CHANGELOG.md was not
  updated. If this change is user-visible (new endpoint, config key, security
  fix, etc.) please add a CHANGELOG.md entry under ## [Unreleased].
  See CLAUDE.md "Changelog Process" for the entry format.
  (This is a warning — your commit will proceed.)
EOF
fi

# ── CSS: regenerate Tailwind output when templates / CSS / config change ──
#
# Why: app.css is a checked-in build artifact embedded into the binary via
# include_bytes!. Templates may reference a utility class that wasn't yet
# in the compiled bundle — only a fresh tailwind run picks them up. CI's
# `make css-check` enforces freshness; this hook avoids the round-trip.
staged_css_inputs=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(templates/|ui/input\.css$|ui/tailwind\.config\.js$)' || true)

if [ -n "$staged_css_inputs" ]; then
  if [ ! -x ui/tailwindcss ] && ! [ -L ui/tailwindcss ]; then
    cat >&2 <<'EOF'
error: pre-commit hook needs ui/tailwindcss to rebuild app.css.

Install the standalone CLI:  make tailwind-install
Then retry the commit.

To bypass (discouraged — CI will fail via 'make css-check'):
  git commit --no-verify
EOF
    exit 1
  fi

  echo "template/CSS changes staged; rebuilding Tailwind app.css..."
  (cd ui && ./tailwindcss -i input.css -o ../src/protocol/web/assets/app.css --minify 2>&1 | grep -v -E '^(zoxide|Browserslist|Please|If the|https://|npx |  Why|Disable|$)' || true)

  git add src/protocol/web/assets/app.css
fi

exit 0
