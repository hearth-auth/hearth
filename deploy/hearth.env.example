# deploy/hearth.env.example — optional environment overrides for the Hearth
# container in deploy/docker-compose.yml.
#
# Usage:
#   cp deploy/hearth.env.example deploy/hearth.env    # then edit
#   docker compose -f deploy/docker-compose.yml up -d
#
# deploy/hearth.env is gitignored. The compose file marks it `required: false`,
# so the stack starts without it.
#
# SCOPE — this file is read by ONE service, so it holds only that service's
# keys. Compose injects every key here into the container's runtime
# environment, where `docker inspect` can read them. Do not put credentials for
# anything other than Hearth in it, and do not point compose at the repository
# root .env: audit 2026-08-28 §4.8#17. scripts/check-compose-env-scope.sh fails
# the build if a key outside this scope appears here.
#
# Precedence: values here override hearth.yaml, which is bind-mounted read-only
# at /etc/hearth/hearth.yaml. The compose file's own `environment:` block wins
# over both. See docs/specs/CONFIGURATION.md for the full key reference.

# Log filter. Overrides the compose default of "info,hearth=debug".
# RUST_LOG=info

# Address the server binds INSIDE the container. The compose file already sets
# this to 0.0.0.0; the published port mapping decides host reachability.
# HEARTH_BIND_ADDRESS=0.0.0.0

# OpenTelemetry OTLP endpoint, if you export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
