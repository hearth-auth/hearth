{
  "name": "hearth-ui-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:smoke": "bash ./pw-run.sh test --project=smoke",
    "test:flows": "bash ./pw-run.sh test --project=flows",
    "test:regression": "bash ./pw-run.sh test --project=regression --project=destructive",
    "test:components": "bash ./pw-run.sh test --project=components --project=destructive",
    "test:accessibility": "bash ./pw-run.sh test --project=accessibility",
    "test:exploratory": "bash ./pw-run.sh test --project=exploratory",
    "test:visual": "bash ./pw-run.sh test --project=visual",
    "test:integration": "bash ./integration/run-integration.sh",
    "test:visual:update": "bash ./pw-run.sh test --project=visual --update-snapshots",
    "test:cross-browser": "bash ./pw-run.sh test --project=smoke --project=flows --project=regression",
    "test:all": "bash ./pw-run.sh test --project=smoke --project=flows --project=regression --project=components --project=destructive --project=accessibility",
    "test:unit": "node --import tsx --test fixtures/*.test.ts",
    "extract-routes": "tsx scripts/extract-routes.ts",
    "coverage-check": "tsx scripts/coverage-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.0",
    "wait-on": "^8.0.0",
    "tsx": "^4.19.0"
  }
}
