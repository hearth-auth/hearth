{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Read", "Effect": "Allow", "Action": ["ec2:Describe*"], "Resource": "*",
     "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}},
    {"Sid": "LaunchTaggedC7i", "Effect": "Allow", "Action": "ec2:RunInstances",
     "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
     "Condition": {"StringLike": {"aws:RequestTag/hearth-stress": "hearth-stress-*",
                                  "ec2:InstanceType": ["c7i.large", "c7i.xlarge", "c7i.2xlarge"]}}},
    {"Sid": "LaunchTaggedVolumes", "Effect": "Allow", "Action": "ec2:RunInstances",
     "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:volume/*",
     "Condition": {"StringLike": {"aws:RequestTag/hearth-stress": "hearth-stress-*"}}},
    {"Sid": "LaunchInputs", "Effect": "Allow", "Action": "ec2:RunInstances",
     "Resource": ["arn:aws:ec2:us-east-1::image/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:subnet/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:network-interface/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:key-pair/*"]},
    {"Sid": "TagOnCreate", "Effect": "Allow", "Action": "ec2:CreateTags",
     "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:*/*",
     "Condition": {"StringEquals": {"ec2:CreateAction": ["RunInstances", "CreateSecurityGroup", "ImportKeyPair"]}}},
    {"Sid": "CreateTaggedGroupAndKey", "Effect": "Allow",
     "Action": ["ec2:CreateSecurityGroup", "ec2:ImportKeyPair"],
     "Resource": ["arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:key-pair/*"],
     "Condition": {"StringLike": {"aws:RequestTag/hearth-stress": "hearth-stress-*"}}},
    {"Sid": "GroupInVpc", "Effect": "Allow", "Action": "ec2:CreateSecurityGroup",
     "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:vpc/*"},
    {"Sid": "ChangeOnlyTagged", "Effect": "Allow",
     "Action": ["ec2:TerminateInstances", "ec2:DeleteSecurityGroup", "ec2:DeleteKeyPair",
                "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
     "Resource": ["arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
                  "arn:aws:ec2:us-east-1:ACCOUNT_ID:key-pair/*"],
     "Condition": {"StringLike": {"aws:ResourceTag/hearth-stress": "hearth-stress-*"}}},
    {"Sid": "GroupRules", "Effect": "Allow",
     "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
     "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group-rule/*"},
    {"Sid": "UbuntuAmi", "Effect": "Allow", "Action": "ssm:GetParameter",
     "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/ubuntu/*"}
  ]
}
