# The images of the same-hardware comparison (#913): each vendor's official
# image at the release under test, pinned by digest (the multi-arch index
# digest that `docker pull <name>:<tag>` reports). The tag is for the reader
# only; the digest decides what runs. Change a digest only in a reviewed PR.

# Keycloak 26.8.2 (released 2026-11-05).
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2@sha256:7e66a96e4739239070aeaf72e4c5decf0f7f682cfc725b9f7ea2b336eaba38b3

# Zitadel v4.20.5 (released 2026-11-18), the official image (ghcr.io, as in
# Zitadel's own compose files).
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.20.5@sha256:cb21fe73badfe44972bb24a66cf0ebce6a8dc63ab8ed24567af6b731bd8bbf45

# Ory Hydra v26.2.0 and Ory Kratos v26.2.0 (both released 2026-03-20), the
# official images (Docker Hub, as in Ory's own compose files), and Ory's
# reference login and consent UI at the same release (kratos-selfservice-ui-node,
# tag v26.2.0), which Hydra needs as its login and consent app.
HYDRA_IMAGE=oryd/hydra:v26.2.0@sha256:ff67c7fb5f95074fa53374d41151713554960504b340cd3f95b09e65deaea2a9
KRATOS_IMAGE=oryd/kratos:v26.2.0@sha256:2a13bb8d362c7a7ae33bd7c0f5168aee46921f15c916a06346db91c06dc76643
UI_IMAGE=oryd/kratos-selfservice-ui-node:v26.2.0@sha256:46a7bac1ad0c67c692b37d0380613fd4618fd751afac2c5314aa8d3ae77ef1f0

# PostgreSQL 18.7, for every product that needs PostgreSQL, with
# postgres/postgresql.conf.
POSTGRES_IMAGE=postgres:18.7@sha256:eb63372c1e05c755f55fa30cbd07aecc443676fc6c0fa90b9002d01537841e1a

# k6 2.0.0, the version cloud.sh installs on the generators, for local runs
# (k6.sh) on a host without k6.
K6_IMAGE=grafana/k6:2.0.0@sha256:a33a0cfdc4d2483d6b7a3a22e726a499ff2831a671a49239104cd34a9937523c
